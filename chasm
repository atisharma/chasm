#!/usr/bin/env python3
"""Chasm CLI -- create, launch, and manage text adventure games."""

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path


XDG_DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
CHASM_DATA = XDG_DATA_HOME / "chasm"
TEMPLATE_DIR = CHASM_DATA / "template"
GAMES_DIR = CHASM_DATA / "games"
SOURCE_DIR = CHASM_DATA / "chasm"
CANONICAL_REPO = os.environ.get(
    "CHASM_REPO_URL", "https://github.com/atisharma/chasm.git"
)

# Managed files: came from the template, safe to overwrite on update.
# Everything else (memory/**, models.json, APPEND_SYSTEM.md, sessions/,
# .git/) is game-owned and never touched by 'chasm update GAME'.
MANAGED_FILES = [
    "settings.json",
    "bin/bootstrap",
    "bin/save",
    "bin/chasm-validate",
    ".gitignore",
]
# The extensions directory is managed wholesale: *.ts files the template no
# longer ships are removed as well as refreshed.
MANAGED_EXT_DIR = Path(".pi") / "extensions"


def die(msg: str) -> None:
    print(f"Error: {msg}", file=sys.stderr)
    sys.exit(1)


def print_help():
    print("Usage: chasm  command  [options]")
    print("")
    print("Commands:")
    print("  new GAME_NAME [--dir PATH]    Scaffold a new game workspace")
    print("                                 (GAME_NAME: letters, digits, hyphens, underscores only)")
    print("  play GAME_NAME                Launch a game (bootstraps on first run)")
    print("  validate [GAME_NAME]          Validate world integrity (defaults to cwd)")
    print("  delete GAME_NAME [--force]    Destroy a game workspace")
    print("  list                          List all games")
    print("  update [GAME] [--all] [--force]")
    print("                                update: refresh installed template + CLI")
    print("                                update GAME: refresh managed tooling files in a game")
    print("                                update --all: refresh tooling in every game")
    print("                                --force: overwrite locally-modified tooling files")
    print("  --help                        Show this help text")
    print("")
    print("Examples:")
    print("  chasm new sunken-quarter")
    print("  chasm play sunken-quarter")
    print("  chasm delete sunken-quarter")
    print("  chasm list")
    print("  chasm update")
    print("  chasm update sunken-quarter")


def cmd_validate(args: argparse.Namespace) -> None:
    name = args.name
    target = None

    if name and (GAMES_DIR / name).is_dir():
        target = GAMES_DIR / name
    elif name and Path(name).is_dir():
        target = Path(name).resolve()
    elif not name:
        # Try current directory
        target = Path.cwd()
    else:
        die(f"Game '{name}' not found.")

    validator = target / "bin" / "chasm-validate"
    if not validator.exists():
        die(f"Validator not found at {validator}. Is this a chasm game?")

    result = subprocess.run([sys.executable, str(validator), str(target)], check=False)
    sys.exit(result.returncode)


def cmd_new(args: argparse.Namespace) -> None:
    name = args.name
    if not name or not all(c.isalnum() or c in "_-" for c in name):
        die("GAME_NAME must contain only letters, digits, hyphens, or underscores (no spaces). Try: london-is-calling")

    if args.dir:
        target = Path(args.dir).expanduser().resolve() / name
    else:
        target = GAMES_DIR / name

    if target.exists() and any(target.iterdir()):
        die(f"{target} already exists and is not empty.")

    if not TEMPLATE_DIR.exists():
        die(f"Template not found at {TEMPLATE_DIR}. Run the install script first.")

    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(TEMPLATE_DIR, target)
    (target / "memory" / "daily").mkdir(parents=True, exist_ok=True)

    # Symlink models.json from the chasm data directory so games inherit
    # the user's gaming model config. This persists across template updates.
    # Template/models.json is only an example/reference.
    user_models = CHASM_DATA / "models.json"
    if user_models.exists():
        (target / "models.json").unlink(missing_ok=True)
        (target / "models.json").symlink_to(user_models)

    subprocess.run(["git", "-C", str(target), "init", "--quiet"], check=True)
    subprocess.run(["git", "-C", str(target), "add", "-A"], check=True)
    subprocess.run(["git", "-C", str(target), "commit", "--quiet", "-m",
                    f"[chasm] Scaffold game: {name}"], check=True)

    print(f"Created {name} at {target}.")
    print(f"Run 'chasm play {name}' to begin.")


def is_uninitialised(world_md: Path) -> bool:
    if not world_md.exists():
        return True
    text = world_md.read_text()
    return "Your World" in text or "TODO" in text


def cmd_play(args: argparse.Namespace) -> None:
    name = args.name
    target = None

    if (GAMES_DIR / name).is_dir():
        target = GAMES_DIR / name
    elif Path(name).is_dir():
        target = Path(name).resolve()
    else:
        die(f"Game '{name}' not found.")

    world_md = target / "memory" / "WORLD.md"
    if not world_md.exists():
        die(f"Corrupt game -- no WORLD.md found in {target}")

    if is_uninitialised(world_md):
        os.environ["PI_CODING_AGENT_DIR"] = str(target)
        os.environ["PI_MEMORY_DIR"] = str(target / "memory")
        os.chdir(target)
        result = subprocess.run([sys.executable, str(target / "bin" / "bootstrap")], check=False)
        if result.returncode != 0:
            die(f"Bootstrap failed with exit code {result.returncode}")
        print("---")

    os.environ["PI_CODING_AGENT_DIR"] = str(target)
    os.environ["PI_MEMORY_DIR"] = str(target / "memory")
    os.chdir(target)

    # Default to continuing previous session; user can override with session flags
    session_flags = {"--continue", "-c", "--no-session", "--session", "--fork"}
    if any(f in args.extra for f in session_flags):
        pi_args = ["pi"] + args.extra
    else:
        pi_args = ["pi", "--continue"] + args.extra

    os.execvp("pi", pi_args)


def cmd_delete(args: argparse.Namespace) -> None:
    name = args.name
    target = None

    if (GAMES_DIR / name).is_dir():
        target = GAMES_DIR / name
    elif Path(name).is_dir():
        target = Path(name).resolve()
    else:
        die(f"Game '{name}' not found.")

    if not args.force:
        ans = input(f"Delete {target}? This cannot be undone. [y/N]: ")
        if ans.lower() not in ("y", "yes"):
            print("Aborted.")
            return

    shutil.rmtree(target)
    print(f"Deleted {target}.")


def cmd_list(_: argparse.Namespace) -> None:
    if not GAMES_DIR.exists():
        print("No games found. Create one with 'chasm new GAME_NAME'.")
        return

    print(f"{'Game':20}  {'Created':12}  Title")
    print("-" * 60)

    for game_path in sorted(GAMES_DIR.iterdir()):
        if not game_path.is_dir():
            continue
        name = game_path.name
        created = "no git"
        if (game_path / ".git").is_dir():
            try:
                out = subprocess.check_output(
                    ["git", "-C", str(game_path), "log", "--format=%as", "-1"],
                    text=True, stderr=subprocess.DEVNULL
                ).strip()
                created = out if out else "unknown"
            except subprocess.CalledProcessError:
                pass
        title = ""
        world_md = game_path / "memory" / "WORLD.md"
        if world_md.exists():
            first = world_md.read_text().splitlines()[0] if world_md.read_text() else ""
            title = first.lstrip("# ").strip() if first.startswith("#") else "(uninitialised)"
        print(f"{name:20}  {created:12}  {title}")


def _atomic_copy(src: Path, dst: Path) -> None:
    """Copy src over dst via temp-then-rename so a failure mid-copy never
    leaves a half-written file in place."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_name(dst.name + ".chasm-tmp")
    shutil.copy2(src, tmp)
    os.replace(tmp, dst)


def _ensure_source_checkout() -> None:
    """Clone or pull the canonical repo into $CHASM_DATA/chasm.

    Web installs clone there too, but manual installs have no recorded
    source location, so 'chasm update' maintains its own checkout.
    """
    if (SOURCE_DIR / ".git").is_dir():
        result = subprocess.run(
            ["git", "-C", str(SOURCE_DIR), "pull", "--ff-only"],
            capture_output=True, text=True,
        )
    else:
        pre_existed = SOURCE_DIR.exists()
        SOURCE_DIR.parent.mkdir(parents=True, exist_ok=True)
        result = subprocess.run(
            ["git", "clone", CANONICAL_REPO, str(SOURCE_DIR)],
            capture_output=True, text=True,
        )
        if result.returncode != 0 and not pre_existed:
            # A failed clone can leave a partial directory behind; remove it
            # so the next attempt starts clean. A directory that existed
            # before we tried is left alone.
            shutil.rmtree(SOURCE_DIR, ignore_errors=True)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        die(f"Cannot reach {CANONICAL_REPO}. Check your network and try again.\n"
            f"git said: {detail}")


def _refresh_template() -> int:
    """Mirror the source checkout's template/ into $CHASM_DATA/template.
    Returns the number of files changed."""
    src_root = SOURCE_DIR / "template"
    if not src_root.is_dir():
        die(f"Source checkout at {SOURCE_DIR} has no template/ directory.")

    changed = 0
    for src in sorted(src_root.rglob("*")):
        if src.is_dir():
            continue
        dst = TEMPLATE_DIR / src.relative_to(src_root)
        if dst.is_file() and dst.read_bytes() == src.read_bytes():
            continue
        _atomic_copy(src, dst)
        changed += 1

    # Remove files the template no longer ships.
    if TEMPLATE_DIR.is_dir():
        for dst in sorted(TEMPLATE_DIR.rglob("*"), reverse=True):
            rel = dst.relative_to(TEMPLATE_DIR)
            if dst.is_dir():
                if not any(dst.iterdir()):
                    dst.rmdir()
            elif not (src_root / rel).exists():
                dst.unlink()
                changed += 1
    return changed


def cmd_update_self(_: argparse.Namespace) -> None:
    _ensure_source_checkout()
    changed = _refresh_template()

    cli_src = SOURCE_DIR / "chasm"
    cli_dst = Path(__file__).resolve()
    cli_changed = False
    if cli_src.is_file() and not cli_dst.is_relative_to(SOURCE_DIR) and not (
        cli_dst.is_file() and cli_dst.read_bytes() == cli_src.read_bytes()
    ):
        # Safe even though this script is running: Python loaded the whole
        # file at startup, and os.replace swaps the inode, not the contents.
        # A checkout's own ./chasm is never rewritten over itself.
        _atomic_copy(cli_src, cli_dst)
        os.chmod(cli_dst, 0o755)
        cli_changed = True

    if changed or cli_changed:
        print(f"Updated template + CLI from {CANONICAL_REPO}")
    else:
        print(f"Already up to date with {CANONICAL_REPO}")
    print(f"  (config at {CHASM_DATA / 'models.json'} preserved)")
    if GAMES_DIR.is_dir() and any(GAMES_DIR.iterdir()):
        print("  Run 'chasm update --all' to refresh existing games.")


def _is_locally_modified(game_dir: Path, rel: str) -> bool:
    """True if rel differs from the game's last commit (modified or
    untracked). Callers only invoke this when the game is a git repo."""
    result = subprocess.run(
        ["git", "-C", str(game_dir), "status", "--porcelain", "--", rel],
        capture_output=True, text=True,
    )
    return result.returncode == 0 and bool(result.stdout.strip())


def _is_tracked(game_dir: Path, rel: str) -> bool:
    result = subprocess.run(
        ["git", "-C", str(game_dir), "ls-files", "--error-unmatch", "--", rel],
        capture_output=True,
    )
    return result.returncode == 0


def cmd_update_game(name: str, force: bool) -> None:
    if (GAMES_DIR / name).is_dir():
        target = GAMES_DIR / name
    elif Path(name).is_dir():
        target = Path(name).resolve()
    else:
        die(f"Game '{name}' not found.")

    if not TEMPLATE_DIR.is_dir():
        die(f"Template not found at {TEMPLATE_DIR}. Run 'chasm update' first.")

    is_git = (target / ".git").is_dir()
    if not is_git:
        print(f"Warning: {target} is not a git repo; cannot detect local "
              "edits or commit. Continuing.")

    changed: list[str] = []
    removed: list[str] = []
    skipped: list[str] = []

    def refresh(rel: str, src: Path, dst: Path) -> None:
        if dst.is_file() and dst.read_bytes() == src.read_bytes():
            return
        if not force and is_git and _is_locally_modified(target, rel):
            print(f"SKIP  {rel} (modified since scaffold)")
            skipped.append(rel)
            return
        _atomic_copy(src, dst)
        changed.append(rel)

    for rel in MANAGED_FILES:
        src = TEMPLATE_DIR / rel
        if src.is_file():
            refresh(rel, src, target / rel)

    src_ext = TEMPLATE_DIR / MANAGED_EXT_DIR
    dst_ext = target / MANAGED_EXT_DIR
    shipped = set()
    if src_ext.is_dir():
        for src in sorted(src_ext.glob("*.ts")):
            shipped.add(src.name)
            rel = str(MANAGED_EXT_DIR / src.name)
            refresh(rel, src, dst_ext / src.name)
    if dst_ext.is_dir():
        # Drop extensions the template no longer ships.
        for dst in sorted(dst_ext.glob("*.ts")):
            if dst.name in shipped:
                continue
            rel = str(MANAGED_EXT_DIR / dst.name)
            if not force and is_git and _is_locally_modified(target, rel):
                print(f"SKIP  {rel} (modified since scaffold)")
                skipped.append(rel)
                continue
            dst.unlink()
            removed.append(rel)

    if changed or removed:
        if is_git:
            # Stage what exists; deletions of never-tracked files have
            # nothing to stage and drop out here.
            existing = [r for r in changed + removed if (target / r).exists()]
            gone_tracked = [r for r in removed
                            if not (target / r).exists() and _is_tracked(target, r)]
            if existing:
                subprocess.run(
                    ["git", "-C", str(target), "add", "-A", "--", *existing],
                    check=True,
                )
            if gone_tracked:
                subprocess.run(
                    ["git", "-C", str(target), "rm", "-r", "--cached",
                     "--quiet", "--ignore-unmatch", "--", *gone_tracked],
                    check=True,
                )
            # Path-limited commit: commits exactly these paths and leaves
            # any unrelated staged work in the game untouched. A --force
            # overwrite that restores a file to its last-committed content
            # leaves nothing staged for these paths, so skip the commit.
            commit_paths = existing + gone_tracked
            if commit_paths:
                staged = subprocess.run(
                    ["git", "-C", str(target), "diff", "--cached",
                     "--quiet", "--", *commit_paths],
                )
                if staged.returncode != 0:
                    subprocess.run(
                        ["git", "-C", str(target), "commit", "--quiet",
                         "-m", "[chasm] Update template files", "--",
                         *commit_paths],
                        check=True,
                    )
        if changed:
            print(f"Updated {name}: {', '.join(changed)}")
        if removed:
            print(f"Removed from {name}: {', '.join(removed)}")
        print("  (memory/, models.json, APPEND_SYSTEM.md untouched)")
    elif skipped:
        print(f"Nothing updated in {name} (all changed files skipped; "
              "use --force to overwrite).")
    else:
        print(f"{name} is already up to date.")


def cmd_update(args: argparse.Namespace) -> None:
    if shutil.which("git") is None:
        die("git is required for 'chasm update'.")
    if args.all and args.name:
        die("'chasm update --all' does not take a game name.")
    if args.force and not (args.all or args.name):
        die("--force requires a game name or --all.")

    if args.name:
        cmd_update_game(args.name, args.force)
    elif args.all:
        games = sorted(p for p in GAMES_DIR.iterdir() if p.is_dir()) \
            if GAMES_DIR.is_dir() else []
        if not games:
            print("No games found.")
            return
        for game in games:
            cmd_update_game(game.name, args.force)
    else:
        cmd_update_self(args)


def main():
    parser = argparse.ArgumentParser(add_help=False)
    subparsers = parser.add_subparsers(dest="command")

    p_new = subparsers.add_parser("new")
    p_new.add_argument("name")
    p_new.add_argument("--dir", default="")

    p_play = subparsers.add_parser("play")
    p_play.add_argument("name")
    p_play.add_argument("extra", nargs=argparse.REMAINDER, default=[])

    p_validate = subparsers.add_parser("validate")
    p_validate.add_argument("name", nargs="?", default="")

    p_delete = subparsers.add_parser("delete")
    p_delete.add_argument("name")
    p_delete.add_argument("--force", action="store_true", help="Skip confirmation")

    p_update = subparsers.add_parser("update")
    p_update.add_argument("name", nargs="?", default="")
    p_update.add_argument("--all", action="store_true",
                          help="Update managed files in every game")
    p_update.add_argument("--force", action="store_true",
                          help="Overwrite locally-modified managed files")

    subparsers.add_parser("list")

    try:
        args = parser.parse_args()
    except SystemExit as e:
        # argparse exits on error; give a helpful hint for common mistakes
        if e.code != 0 and len(sys.argv) > 1 and sys.argv[1] == "new" and len(sys.argv) > 2:
            if " " in sys.argv[2] or len(sys.argv) > 3:
                print("\nHint: Use quotes for multi-word game names.", file=sys.stderr)
                print("  chasm new \"London is calling\"", file=sys.stderr)
                print("Or use hyphens: chasm new london-is-calling", file=sys.stderr)
        sys.exit(1)

    if args.command is None:
        print_help()
        sys.exit(1)

    if args.command == "new":
        cmd_new(args)
    elif args.command == "play":
        cmd_play(args)
    elif args.command == "validate":
        cmd_validate(args)
    elif args.command == "delete":
        cmd_delete(args)
    elif args.command == "update":
        cmd_update(args)
    elif args.command == "list":
        cmd_list(args)
    else:
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
